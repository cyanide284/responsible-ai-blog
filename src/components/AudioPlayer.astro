---
interface Props {
	src: string;
}
const { src } = Astro.props;
---

<div class="audio-player" id="audio-player">
	<button class="audio-toggle" id="audio-toggle" type="button" aria-label="Listen to this post">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
			<path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
		</svg>
		<span class="audio-toggle-text">Listen</span>
	</button>
	<div class="audio-controls" id="audio-controls" hidden>
		<audio id="audio-el" src={src} preload="none"></audio>
		<button class="audio-btn" id="audio-play-pause" type="button" aria-label="Play">
			<span class="play-icon" aria-hidden="true">▶</span>
			<span class="pause-icon" aria-hidden="true" hidden>❚❚</span>
		</button>
		<input type="range" id="audio-seek" class="audio-seek" min="0" value="0" step="0.1" aria-label="Seek" />
		<span class="audio-time" id="audio-time" aria-live="polite">0:00</span>
		<select id="audio-speed" class="audio-select" aria-label="Playback speed">
			<option value="0.85">0.85×</option>
			<option value="1" selected>1×</option>
			<option value="1.15">1.15×</option>
			<option value="1.35">1.35×</option>
			<option value="1.6">1.6×</option>
		</select>
	</div>
</div>

<script>
	(function () {
		const toggleBtn = document.getElementById('audio-toggle') as HTMLButtonElement | null;
		const controls = document.getElementById('audio-controls') as HTMLDivElement | null;
		const audio = document.getElementById('audio-el') as HTMLAudioElement | null;
		const playPauseBtn = document.getElementById('audio-play-pause') as HTMLButtonElement | null;
		const seekBar = document.getElementById('audio-seek') as HTMLInputElement | null;
		const timeEl = document.getElementById('audio-time') as HTMLSpanElement | null;
		const speedSelect = document.getElementById('audio-speed') as HTMLSelectElement | null;
		const playIcon = playPauseBtn?.querySelector('.play-icon') as HTMLSpanElement | null;
		const pauseIcon = playPauseBtn?.querySelector('.pause-icon') as HTMLSpanElement | null;

		if (!toggleBtn || !controls || !audio || !playPauseBtn || !seekBar || !timeEl || !speedSelect) return;

		function fmt(s: number): string {
			const m = Math.floor(s / 60);
			const sec = Math.floor(s % 60);
			return `${m}:${sec.toString().padStart(2, '0')}`;
		}

		function setPlaying(playing: boolean) {
			if (!playIcon || !pauseIcon) return;
			playIcon.hidden = playing;
			pauseIcon.hidden = !playing;
			playPauseBtn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
		}

		function updateTime() {
			if (!timeEl || !seekBar) return;
			const cur = audio.currentTime;
			const dur = audio.duration;
			timeEl.textContent = isNaN(dur) ? fmt(cur) : `${fmt(cur)} / ${fmt(dur)}`;
			seekBar.value = String(cur);
		}

		audio.addEventListener('loadedmetadata', () => {
			seekBar.max = String(audio.duration);
			updateTime();
		});

		audio.addEventListener('timeupdate', updateTime);

		audio.addEventListener('ended', () => {
			setPlaying(false);
			audio.currentTime = 0;
			seekBar.value = '0';
			updateTime();
		});

		toggleBtn.addEventListener('click', () => {
			if (controls.hidden) {
				controls.hidden = false;
				toggleBtn.classList.add('open');
				audio.play();
				setPlaying(true);
			} else {
				audio.pause();
				audio.currentTime = 0;
				controls.hidden = true;
				toggleBtn.classList.remove('open');
				setPlaying(false);
			}
		});

		playPauseBtn.addEventListener('click', () => {
			if (audio.paused) {
				audio.play();
				setPlaying(true);
			} else {
				audio.pause();
				setPlaying(false);
			}
		});

		seekBar.addEventListener('input', () => {
			audio.currentTime = parseFloat(seekBar.value);
		});

		speedSelect.addEventListener('change', () => {
			audio.playbackRate = parseFloat(speedSelect.value);
		});

		window.addEventListener('beforeunload', () => audio.pause());

		document.addEventListener('visibilitychange', () => {
			if (document.hidden && !audio.paused) {
				audio.pause();
				setPlaying(false);
			}
		});
	})();
</script>

<style>
	.audio-player {
		margin: 0 0 2rem 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--bg-subtle);
		font-size: 0.85rem;
	}
	.audio-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: none;
		border: none;
		color: var(--text);
		font-family: var(--font-body);
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
		padding: 0.2rem 0;
		transition: color 0.15s;
	}
	.audio-toggle:hover {
		color: var(--accent);
	}
	.audio-toggle.open .audio-toggle-text::after {
		content: ' (stop)';
		font-weight: 400;
		color: var(--text-muted);
	}
	.audio-toggle svg {
		flex-shrink: 0;
	}
	.audio-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.65rem;
		padding-top: 0.65rem;
		border-top: 1px solid var(--border);
	}
	.audio-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.9rem;
		height: 1.9rem;
		background: white;
		border: 1px solid var(--border);
		border-radius: 4px;
		color: var(--text);
		font-size: 0.7rem;
		cursor: pointer;
		transition: all 0.15s;
		flex-shrink: 0;
	}
	.audio-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.audio-seek {
		flex: 1;
		min-width: 4rem;
		height: 3px;
		accent-color: var(--accent);
		cursor: pointer;
	}
	.audio-time {
		font-size: 0.75rem;
		color: var(--text-subtle);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.audio-select {
		font-family: var(--font-body);
		font-size: 0.8rem;
		padding: 0.3rem 0.5rem;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: white;
		color: var(--text);
	}
	@media (max-width: 540px) {
		.audio-controls {
			gap: 0.4rem;
		}
		.audio-seek {
			min-width: 2rem;
		}
	}
</style>
