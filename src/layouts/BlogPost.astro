---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { readingTime } from '../utils/readingTime';
import Subscribe from '../components/Subscribe.astro';
import AudioPlayer from '../components/AudioPlayer.astro';

type Props = CollectionEntry<'blog'>['data'] & { body?: string };

const { title, description, author, authorUrl, pubDate, updatedDate, heroImage, tags, series, seriesPart, readingTime: readingTimeOverride, audio, body } = Astro.props;
const rt = readingTimeOverride ?? (body ? readingTime(body) : '');
const seriesSlug = series ? series.toLowerCase().replace(/\s+/g, '-') : '';
const postSlug = Astro.url.pathname.split('/').filter(Boolean).pop() ?? '';
const audioSrc = `/audio/${postSlug}.mp3`;
// The byline shows the LinkedIn mark for a LinkedIn profile, and falls back to
// linking the name itself for anything else, so authorUrl stays generic.
//
// The scheme is re-checked here rather than trusted from the schema. This value
// becomes an href, so if the schema is ever loosened back to a plain string the
// failure should be a missing link, not script running in the site's origin.
// Parsing is wrapped because a URL that cannot be parsed must not break a build.
let authorHref: string | undefined;
let authorIsLinkedIn = false;
if (authorUrl) {
	try {
		const parsed = new URL(authorUrl);
		if (parsed.protocol === 'https:' || parsed.protocol === 'http:') {
			authorHref = authorUrl;
			authorIsLinkedIn = /(^|\.)linkedin\.com$/.test(parsed.hostname);
		}
	} catch {
		/* unparseable, so no byline link */
	}
}
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="post-header">
					{series && (
						<div class={`series-chip series-${seriesSlug}`}>
							<span class="series-name">{series}</span>
							{seriesPart && <><span class="series-sep">·</span><span class="series-part">Part {seriesPart}</span></>}
						</div>
					)}
					<div class="post-meta">
						{author && (
							<>
								{authorHref && !authorIsLinkedIn
									? <a class="author author-link" href={authorHref} target="_blank" rel="noopener author">{author}</a>
									: <span class="author">{author}</span>}
								{authorIsLinkedIn && (
									<a class="author-social" href={authorHref} target="_blank" rel="noopener author" title={`${author} on LinkedIn`}>
										<span class="sr-only">{author} on LinkedIn</span>
										<svg viewBox="0 0 24 24" aria-hidden="true" width="14" height="14" fill="currentColor">
											<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
										</svg>
									</a>
								)}
								<span class="dot">·</span>
							</>
						)}
						<FormattedDate date={pubDate} />
						{rt && <><span class="dot">·</span><span>{rt}</span></>}
						{updatedDate && (
							<><span class="dot">·</span><span class="updated">Updated <FormattedDate date={updatedDate} /></span></>
						)}
					</div>
					<h1>{title}</h1>
					{description && <p class="description">{description}</p>}
					{tags && tags.length > 0 && (
						<div class="tags">
							{tags.map((tag: string) => <span class="tag">{tag}</span>)}
						</div>
					)}
					<hr />
				</header>
				{heroImage && (
					<figure class="hero-image">
						<Image src={heroImage} alt={title} />
						<figcaption>Generated with ChatGPT</figcaption>
					</figure>
				)}
				{audio && <AudioPlayer src={audioSrc} />}
				<div class="prose">
					<slot />
				</div>
				<Subscribe />
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: 2.5rem;
	}
	.post-header {
		margin-bottom: 2.5rem;
	}
	.series-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.3rem 0.65rem;
		border-radius: 4px;
		background: var(--accent);
		color: var(--on-accent);
		margin-bottom: 0.85rem;
	}
	.series-chip .series-sep { opacity: 0.6; }
	.series-chip .series-part { font-weight: 500; }
	.series-chip.series-evaluation-methodology { background: #475569; color: #fff; }
	.post-meta {
		font-size: 0.8rem;
		color: var(--text-subtle);
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 0.75rem;
	}
	.dot { color: var(--border); }
	.author { font-weight: 600; color: var(--text-muted); }
	/* Underline only on hover: the byline is metadata, and a permanently
	   underlined name competes with the title directly beneath it. */
	a.author-link {
		text-decoration: none;
		transition: color 0.15s;
	}
	a.author-link:hover {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	/* Sits tight against the name rather than in the meta row's normal gap,
	   so it reads as part of the byline and not as another metadata field. */
	a.author-social {
		display: inline-flex;
		align-items: center;
		color: var(--text-subtle);
		text-decoration: none;
		margin-left: -0.15rem;
		transition: color 0.15s;
	}
	a.author-social:hover { color: var(--accent); }
	a.author-social:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
		border-radius: 2px;
	}
	.updated { font-style: italic; }
	.post-header h1 {
		font-size: 2.2rem;
		line-height: 1.2;
		margin: 0 0 0.75rem 0;
	}
	.description {
		font-size: 1rem;
		color: var(--text-muted);
		margin: 0 0 1rem 0;
		line-height: 1.6;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1.5rem;
	}
	hr {
		border: none;
		border-top: 1px solid var(--border);
		margin: 1.5rem 0 0;
	}
	.hero-image {
		margin: 2rem 0 1rem;
		border-radius: 8px;
		overflow: hidden;
	}
	.hero-image img {
		width: 100%;
		height: auto;
		display: block;
	}
	.hero-image figcaption {
		font-size: 0.72rem;
		color: var(--text-subtle);
		text-align: right;
		padding: 0.35rem 0 0;
		font-style: italic;
	}
</style>
