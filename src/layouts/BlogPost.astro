---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { readingTime } from '../utils/readingTime';
import Subscribe from '../components/Subscribe.astro';

type Props = CollectionEntry<'blog'>['data'] & { body?: string };

const { title, description, pubDate, updatedDate, heroImage, tags, body } = Astro.props;
const rt = body ? readingTime(body) : '';
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="post-header">
					<div class="post-meta">
						<FormattedDate date={pubDate} />
						{rt && <><span class="dot">·</span><span>{rt}</span></>}
						{updatedDate && (
							<><span class="dot">·</span><span class="updated">Updated <FormattedDate date={updatedDate} /></span></>
						)}
					</div>
					<h1>{title}</h1>
					{description && <p class="description">{description}</p>}
					{tags && tags.length > 0 && (
						<div class="tags">
							{tags.map((tag: string) => <span class="tag">{tag}</span>)}
						</div>
					)}
					<hr />
				</header>
				{heroImage && (
					<figure class="hero-image">
						<Image src={heroImage} alt={title} />
						<figcaption>Generated with ChatGPT</figcaption>
					</figure>
				)}
				<div class="prose">
					<slot />
				</div>
				<Subscribe />
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: 2.5rem;
	}
	.post-header {
		margin-bottom: 2.5rem;
	}
	.post-meta {
		font-size: 0.8rem;
		color: var(--text-subtle);
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 0.75rem;
	}
	.dot { color: var(--border); }
	.updated { font-style: italic; }
	.post-header h1 {
		font-size: 2.2rem;
		line-height: 1.2;
		margin: 0 0 0.75rem 0;
	}
	.description {
		font-size: 1rem;
		color: var(--text-muted);
		margin: 0 0 1rem 0;
		line-height: 1.6;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1.5rem;
	}
	hr {
		border: none;
		border-top: 1px solid var(--border);
		margin: 1.5rem 0 0;
	}
	.hero-image {
		margin: 2rem 0 1rem;
		border-radius: 8px;
		overflow: hidden;
	}
	.hero-image img {
		width: 100%;
		height: auto;
		display: block;
	}
	.hero-image figcaption {
		font-size: 0.72rem;
		color: var(--text-subtle);
		text-align: right;
		padding: 0.35rem 0 0;
		font-style: italic;
	}
</style>
